APP_ENDPOINT=
APP_DOMAIN=

# Docker image registry.
# IMAGE_TAG и GHCR_TOKEN/GHCR_ACTOR передаются автоматически из CI (secrets.GITHUB_TOKEN).
# Если деплой запускается вручную без CI — задайте переменные ниже:
GHCR_ORG=go-park-mail-ru
# IMAGE_TAG=latest          # тег образа; в CI подставляется SHA коммита автоматически
# GHCR_USER=               # имя пользователя ghcr.io (если токен задан вручную)
# GHCR_TOKEN=              # Personal Access Token с правом read:packages
# RUN_SEED_ON_DEPLOY=0     # 1 — принудительно запускать seed на каждом деплое
# AUTO_SEED_ON_EMPTY=1     # 1 — запускать seed, если нет данных tools/seed

